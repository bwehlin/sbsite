{
  "name": "StableBear site",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind"
  ],
  "postCreateCommand": "pip install --user livereload==2.7.0 && curl -fsSL https://claude.ai/install.sh | bash",
  "remoteEnv": { "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}" },
  "postAttachCommand": "livereload --host 0.0.0.0 -p 8000 .",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "esbenp.prettier-vscode",
        "webhint.vscode-webhint",
        "ecmel.vscode-html-css",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Site preview", "onAutoForward": "openBrowser" }
  }
}
