{
  "name": "StableBear site",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": { "CLAUDE_CONFIG_DIR": "/home/vscode/.claude" },
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.claude && npm ci",
  "postAttachCommand": "npm run dev -- --host 0.0.0.0 --port 8000",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "astro-build.astro-vscode",
        "esbenp.prettier-vscode",
        "webhint.vscode-webhint",
        "ecmel.vscode-html-css",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Site preview", "onAutoForward": "openBrowserOnce" }
  }
}
