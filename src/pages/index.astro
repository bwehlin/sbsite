---
import Base from "../layouts/Base.astro";
import Showcase from "../components/Showcase.astro";
import CopyCommand from "../components/CopyCommand.astro";
import GitHubLink from "../components/GitHubLink.astro";
import bear from "../../assets/logos/stablebear-bear.svg";
import { getCollection } from "astro:content";

// Newest news item for the highlight beside the install block.
const [latest] = (await getCollection("news")).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base
  title="StableBear"
  description="StableBear is an open-source Python package with a C++/CUDA backend for GPU-accelerated computation on piecewise constant functions."
>
  <div class="stack">
  <section>
    <div class="hero wrap">
    <div class="hero-text">
      <h1>Next-generation statistics engine for TDA</h1>
      <p class="lede">StableBear is built for statistics with topological data analysis (TDA). Typical TDA workloads run highly parallelized and reproducibly, and the results go straight into the tools you already use.</p>
      <p class="actions">
        <a class="button primary" href="https://docs.stablebear.org">Read the docs</a>
        <a class="button" href="#install">Install</a>
      </p>
    </div>
    <img class="hero-bear" src={bear.src} alt="The StableBear bear, sitting cross-legged" width="681" height="613" />
    </div>
  </section>

  <section id="install" class="band" aria-labelledby="install-title">
    <div class="wrap install-grid">
      <div>
        <h2 id="install-title">Install</h2>
        <CopyCommand command="pip install stablebear" />
        <p>Then <code>import stablebear as sb</code> and follow the <a href="https://docs.stablebear.org">documentation</a> for examples.</p>
      </div>
      {latest && (
        <section class="latest" aria-labelledby="latest-title">
          <h2 id="latest-title">Latest news</h2>
          <div class="news-card">
            {latest.data.tag && <p class="badge">{latest.data.tag}</p>}
            <h3>{latest.data.title}</h3>
            <p>{latest.data.summary}</p>
            <p><a href={`${base}news/#${latest.id}`}>Read more</a></p>
          </div>
          <p><a href={`${base}news/`}>All news</a></p>
        </section>
      )}
    </div>
  </section>

  <Showcase />
  </div>

  <section class="wrap" aria-label="Platform">
    <ul class="cards">
      <li>
        <h3>Python, with a C++/CUDA backend</h3>
        <p>A Python interface over a compiled C++ backend, with work-stealing parallelism on the CPU (<a href="https://taskflow.github.io/">Taskflow</a>) and CUDA acceleration on the GPU: <code>import stablebear as sb</code>.</p>
      </li>
      <li>
        <h3>Open source, open for collaboration</h3>
        <p>Source code on <GitHubLink /> under the Apache License 2.0.</p>
      </li>
    </ul>
  </section>
</Base>

<script>
  // Each stacked section sticks once its bottom reaches the bottom of the window, so the next
  // one slides over it. Section i stops i peeks down, so the top strip of every earlier
  // section stays in view. The stack ends with the showcase, which then scrolls away as usual.
  // Everything stops below the fixed navbar, whose height goes in --nav-h.
  const nav = document.querySelector<HTMLElement>(".nav")!;
  const stack = document.querySelector(".stack")!;
  const sections = [...stack.querySelectorAll<HTMLElement>(":scope > section")];
  const peek = () => parseFloat(getComputedStyle(stack).getPropertyValue("--peek")) || 0;
  function stick() {
    const navH = nav.offsetHeight;
    document.documentElement.style.setProperty("--nav-h", `${navH}px`);
    sections.forEach((s, i) =>
      s.style.setProperty("--stick", `${Math.min(navH + i * peek(), innerHeight - s.offsetHeight)}px`));
  }
  new ResizeObserver(stick).observe(document.body);
  addEventListener("resize", stick);

  // A link into a stuck section would scroll to where it is stuck, not where it sits in the
  // page. Measure the target with stacking switched off, then scroll there.
  document.addEventListener("click", (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    const target = a && a.pathname === location.pathname && document.querySelector<HTMLElement>(a.hash);
    if (!target || !target.closest("main")) return;
    e.preventDefault();
    document.documentElement.classList.add("no-stick");
    // Keep clear of the strips of the sections stacked above the target's own.
    const stacked = sections.findIndex((s) => s.contains(target)) * peek();
    const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    const top = scrollY + target.getBoundingClientRect().top - margin - Math.max(0, stacked) - nav.offsetHeight;
    document.documentElement.classList.remove("no-stick");
    scrollTo({ top });
    history.pushState(null, "", a.hash);
  });
</script>
