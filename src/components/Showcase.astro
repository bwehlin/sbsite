---
// Feature showcase: on desktop the side list stays put while the figures scroll past;
// the current item gets a progress bar. Narrow screens stack figures with captions.
import local from "../../assets/highlights/local-topology.svg";
import distances from "../../assets/highlights/distances.svg";
import featureVectors from "../../assets/highlights/features.svg";
// The tensor figures are inlined so they can take the band's colours (see .showcase-tensors).
import pcTensor from "../../tensorfigures/figures/pointcloud-tensor-3x2.svg?raw";
import barcodeTensor from "../../tensorfigures/figures/barcode-tensor-3x2x2-boxes.svg?raw";
import bettiTensor from "../../tensorfigures/figures/betti-tensor-3x2x2.svg?raw";

// Give each inlined SVG its own title/desc ids and keep its <style> rules inside its figure.
const inline = (svg: string, id: string) => svg
  .replace('aria-labelledby="t d"', `aria-labelledby="${id}-t ${id}-d"`)
  .replace('id="t"', `id="${id}-t"`).replace('id="d"', `id="${id}-d"`)
  .replace("<style>", `<style>#${id} {`).replace("</style>", "}</style>");

// The tensor pipeline, shown side by side in the first panel.
const steps = [
  {
    id: "f-pointclouds",
    svg: pcTensor,
    title: "Point clouds in a tensor",
    text: "Point clouds of different sizes can be stored in the same tensor.",
  },
  {
    id: "f-barcodes",
    svg: barcodeTensor,
    title: "Barcodes for all of them",
    text: "Elementwise parallel computations using state-of-the-art algorithms.",
  },
  {
    id: "f-betti-tensor",
    svg: bettiTensor,
    title: "Persistence curves",
    text: "Transformations into Betti curves, stable ranks, etc.",
  },
];

const features = [
  {
    id: "f-local",
    img: local,
    title: "Topological bootstrapping",
    text: "Advanced bootstrapping capabilities allowing extraction of local and global topology in large datasets.",
    alt: "A point cloud of a blob and a noisy ring across the top and small clumps down the left. A chosen point at the right edge of the ring is marked; points near it are gold and turn grey with distance. In the bottom right corner, faint gold H0 stable rank curves of the samples and their bold pale mean.",
    link: { href: "https://docs.stablebear.org/en/latest/tutorial_notebooks/relative_subsampling.html", label: "Relative subsampling tutorial" },
  },
  {
    id: "f-exact",
    img: distances,
    title: "Exact representations",
    text: "Functions are represented without discretization, and computations like distances and kernels are carried out exactly (up to machine precision). Large computations run on the GPU where available.",
    alt: "Two step functions stepping down to zero, one always above the other until both reach zero, each step drawn with a filled dot where it starts and an open dot where it ends, drawn over each other with the area between them split into rectangles at their steps, the first few from the left shaded, and beside them a 20 by 20 distance matrix shaded by distance, with a dark diagonal.",
    link: { href: "https://docs.stablebear.org/en/stable/distances.html", label: "Distances guide" },
  },
  {
    id: "f-ml",
    img: featureVectors,
    title: "Into existing algorithms",
    text: "Persistence curves become feature vectors, distance matrices or kernels for neural networks and other machine learning models.",
    alt: "A step function that climbs unevenly to a peak and steps back down, sampled at twelve evenly spaced points, the twelve values as a column of cells shaded by size, and the cells wired into a small neural network with six hidden units and two outputs.",
    link: { href: "https://docs.stablebear.org/en/stable/tutorial_notebooks/pytorch_tda_classifier.html", label: "PyTorch classifier tutorial" },
  },
];
---

<section id="features" class="showcase" aria-labelledby="features-title">
  <div class="wrap showcase-grid">
    <div class="showcase-side">
      <h2 id="features-title">What it computes</h2>
      <ol class="showcase-nav">
        {[{ id: "f-tensors", title: "Tensors in, tensors out" }, ...features].map((f, i) => (
          <li><a href={`#${f.id}`} aria-current={i === 0 ? "true" : "false"}>{f.title}</a></li>
        ))}
      </ol>
    </div>
    <div class="showcase-panels">
      <figure class="showcase-panel" id="f-tensors">
        <ol class="showcase-tensors">
          {steps.map((f) => (
            <li id={`${f.id}-fig`}>
              <Fragment set:html={inline(f.svg, `${f.id}-fig`)} />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ol>
        <figcaption><p><a href="https://docs.stablebear.org/en/stable/persistence.html">Persistent homology guide</a></p></figcaption>
      </figure>
      {features.map((f) => (
        <figure class="showcase-panel" id={f.id}>
          <img src={f.img.src} width={f.img.width} height={f.img.height} alt={f.alt} loading="lazy" />
          <figcaption>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
            {f.link && <p><a href={f.link.href}>{f.link.label}</a></p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  // Mark the item whose figure is at the middle of the viewport, and how far through it we are.
  const links = document.querySelectorAll<HTMLAnchorElement>(".showcase-nav a");
  const panels = [...links].map((a) => document.querySelector(a.hash)!);

  function track() {
    const mid = innerHeight / 2;
    let current = 0;
    panels.forEach((p, i) => { if (p.getBoundingClientRect().top <= mid) current = i; });
    const r = panels[current].getBoundingClientRect();
    const progress = Math.min(1, Math.max(0, (mid - r.top) / r.height));
    links.forEach((a, i) => {
      a.setAttribute("aria-current", String(i === current));
      a.style.setProperty("--progress", i === current ? `${progress * 100}%` : "0%");
    });
  }
  addEventListener("scroll", () => requestAnimationFrame(track), { passive: true });
  addEventListener("resize", track);
  track();
</script>
